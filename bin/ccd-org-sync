#!/usr/bin/python3 -I
"""ccd-org-sync — Claude Desktop のサイドバー一覧（local_*.json）を org 間で双方向同期する。

  ~/Library/Application Support/Claude/claude-code-sessions/<account>/<org>/local_*.json

- 同じ sessionId は「ファイル更新日時が新しい方」を正として全 org に配る（newer-wins）
- アーカイブ状態（isArchived と archived-sessions.idx）も勝者に合わせて全 org で揃える
- 一度同期済みのセッションがどこかの org で消えていたら、復活させない（削除はしない）
- 変更前後を ~/.ccd-org-sync/git にコミット。`undo` で直前の同期を戻せる
- 会話本体（~/.claude/projects）・認証情報には一切触れない

使い方:
  ccd-org-sync              同期を実行
  ccd-org-sync --dry-run    何が変わるか表示するだけ
  ccd-org-sync status       org ごとの件数・アーカイブ数
  ccd-org-sync log          同期履歴
  ccd-org-sync undo         直前の同期を元に戻す（Desktop を終了してから推奨）
  ccd-org-sync --notify     変更があれば macOS 通知（launchd 用）
  ccd-org-sync agent install    自動実行（launchd）を登録。org/アカウント追加後も再実行
  ccd-org-sync agent uninstall  自動実行を解除
  ccd-org-sync agent status     自動実行の状態
  ccd-org-sync --version
"""
import json, os, re, shutil, subprocess, sys, tempfile, time
from pathlib import Path

__version__ = "0.1.0"
HOME = Path.home()
CCS = Path(os.environ.get("CCD_SESSIONS_DIR",
                          HOME / "Library/Application Support/Claude/claude-code-sessions"))
BASE = Path(os.environ.get("CCD_ORG_SYNC_DIR", HOME / ".ccd-org-sync"))
GIT = BASE / "git"
STATE = BASE / "synced-ids.json"
LOCK = BASE / "lock.d"
IDX = "archived-sessions.idx"


def log(msg):
    print(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}", flush=True)


def orgs():
    return sorted(p for p in CCS.glob("*/*") if p.is_dir())


def label(org):
    return f"{org.parent.name[:8]}/{org.name[:8]}"


def load_session(f):
    try:
        raw = f.read_bytes()
        d = json.loads(raw)
        if not isinstance(d, dict) or d.get("sessionId") != f.stem:
            return None
        return {"path": f, "raw": raw, "data": d, "mtime": f.stat().st_mtime}
    except Exception as e:  # 壊れた/書き込み途中のファイルは触らない
        log(f"WARN skip {f.name}: {e}")
        return None


def load_idx(org):
    p = org / IDX
    if not p.exists():
        return None
    try:
        d = json.loads(p.read_text())
        return d if isinstance(d, dict) and isinstance(d.get("archived"), list) else None
    except Exception:
        return None


def atomic_write(path, data: bytes, mtime=None, mode=0o600):
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".ccd-org-sync-")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        os.chmod(tmp, mode)
        if mtime is not None:
            os.utime(tmp, (mtime, mtime))
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


# ---------- git snapshot ----------
def git(*args, check=True):
    return subprocess.run(["git", "-C", str(GIT), "-c", "core.hooksPath=/dev/null",
                           "-c", "commit.gpgsign=false", *args],
                          capture_output=True, text=True, check=check)


def git_init():
    if not (GIT / ".git").exists():
        GIT.mkdir(parents=True, exist_ok=True)
        subprocess.run(["git", "init", "-q", str(GIT)], check=True)
        git("config", "user.name", "ccd-org-sync")
        git("config", "user.email", "ccd-org-sync@localhost")


def snapshot(msg):
    """一覧ファイルと idx を git 管理下へミラーしてコミット。変化なしならスキップ。"""
    mirror = GIT / "sessions"
    if mirror.exists():
        shutil.rmtree(mirror)
    for org in orgs():
        dst = mirror / org.parent.name / org.name
        dst.mkdir(parents=True, exist_ok=True)
        for f in list(org.glob("local_*.json")) + [org / IDX]:
            if f.is_file():
                shutil.copy2(f, dst / f.name)
    git("add", "-A", "sessions")
    if git("diff", "--cached", "--quiet", check=False).returncode != 0:
        git("commit", "-q", "-m", msg)
        return True
    return False


# ---------- タイトル補完 ----------
PROJECTS = Path(os.environ.get("CLAUDE_PROJECTS_DIR", HOME / ".claude/projects"))
TITLE_LEN = 40


def _text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):  # tool_result だけの発言は対象外
        return " ".join(c.get("text", "") for c in content
                        if isinstance(c, dict) and c.get("type") == "text")
    return ""


def derive_title(cli_id):
    """CLI の会話ファイルから名前を作る。/rename の名前 → AI タイトル → 最初の発言 の順。"""
    if not cli_id or "/" in cli_id:
        return None
    files = list(PROJECTS.glob(f"*/{cli_id}.jsonl"))
    if not files:
        return None
    custom = ai = first = None
    try:
        with open(files[0], encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if '"custom-title"' not in line and '"ai-title"' not in line and \
                        (first or '"user"' not in line):
                    continue
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                t = d.get("type")
                if t == "custom-title" and d.get("customTitle"):
                    custom = d["customTitle"]
                elif t == "ai-title" and d.get("aiTitle"):
                    ai = d["aiTitle"]
                elif t == "user" and not first and not d.get("isMeta"):
                    s = re.sub(r"\[(Image|Pasted text) #\d+[^\]]*\]", " ",
                               _text(d.get("message", {}).get("content")))
                    s = " ".join(s.split())
                    if s and not s.startswith("<"):  # コマンドやシステム挿入は飛ばす
                        first = s
    except OSError:
        return None
    title = custom or ai or first
    return title[:TITLE_LEN] if title else None


# ---------- sync ----------
def okey(org):
    return f"{org.parent.name}/{org.name}"


def load_seen(all_orgs, sessions):
    """{ "<account>/<org>": [その org に一度でも存在した sessionId] } を返す。"""
    if not STATE.exists():
        return {}
    data = json.loads(STATE.read_text())
    if isinstance(data, dict):
        return data
    # 旧形式（全 org 共通のリスト）からの移行: セッションが入っている既存 org にだけ割り当てる
    old = set(data)
    return {okey(o): sorted(old) for o in all_orgs
            if any(org_ == o for by in sessions.values() for org_ in by)}


def plan():
    all_orgs = orgs()
    sessions = {}  # sid -> {org: info}
    for org in all_orgs:
        for f in org.glob("local_*.json"):
            info = load_session(f)
            if info:
                sessions.setdefault(f.stem, {})[org] = info
    seen = load_seen(all_orgs, sessions)

    writes, skipped_deleted, archived, titled = [], [], {}, []
    for sid, by_org in sessions.items():
        winner = max(by_org.values(), key=lambda i: i["mtime"])
        if not winner["data"].get("title"):
            t = derive_title(winner["data"].get("cliSessionId"))
            if t:
                data = dict(winner["data"], title=t, titleSource="auto")
                winner = dict(winner, data=data,
                              raw=json.dumps(data, ensure_ascii=False).encode())
                titled.append((sid, t))
        archived[sid] = bool(winner["data"].get("isArchived"))
        for org in all_orgs:
            cur = by_org.get(org)
            if cur is None:
                if sid in seen.get(okey(org), ()):  # この org に一度あったのに消えている = 削除された
                    skipped_deleted.append((sid, org))
                    continue
                writes.append(("NEW", org / f"{sid}.json", winner))
            elif cur["raw"] != winner["raw"]:
                writes.append(("UPD", cur["path"], winner))

    idx_writes = []
    for org in all_orgs:
        idx = load_idx(org)
        cur = list(idx["archived"]) if idx else []
        new = [s for s in cur if s not in archived or archived[s]]  # 管理外の ID はそのまま残す
        present = {s for s, by in sessions.items() if org in by} | \
                  {w[1].stem for w in writes if w[1].parent == org}
        for sid in sorted(present):
            if archived.get(sid) and sid not in new:
                new.append(sid)
        if new != cur and (idx or new):
            body = dict(idx or {"v": 1})
            body["archived"] = new
            idx_writes.append((org, body, set(new) - set(cur), set(cur) - set(new)))
    return all_orgs, sessions, writes, idx_writes, skipped_deleted, titled


def sync(dry, notify):
    if len(orgs()) < 2:
        log("org が1つしかないので何もしません")
        return
    all_orgs, sessions, writes, idx_writes, skipped, titled = plan()
    for sid, t in titled:
        log(f"TITLE {sid[6:14]} → {t}")

    for kind, path, w in writes:
        log(f"{kind} {label(path.parent)} {path.stem[6:14]} "
            f"[{'archived' if w['data'].get('isArchived') else 'active'}] {w['data'].get('title', '')[:30]}")
    for org, _, add, rem in idx_writes:
        log(f"IDX  {label(org)} アーカイブ +{len(add)} / 解除 -{len(rem)}")
    for sid, org in skipped:
        log(f"SKIP {label(org)} {sid[6:14]}（この org で削除済みのため復活させない）")
    summary = f"新規 {sum(w[0] == 'NEW' for w in writes)} / 更新 {sum(w[0] == 'UPD' for w in writes)} / アーカイブ反映 {len(idx_writes)} org"
    log(f"SUMMARY {summary}{' (dry-run)' if dry else ''}")
    if dry:
        return

    git_init()
    changed = bool(writes or idx_writes)
    if changed:
        snapshot("pre-sync: snapshot")
        for _, path, w in writes:
            atomic_write(path, w["raw"], mtime=w["mtime"])
        for org, body, _, _ in idx_writes:
            p = org / IDX
            mt = p.stat().st_mtime if p.exists() else None
            atomic_write(p, json.dumps(body, ensure_ascii=False, separators=(",", ":")).encode(), mtime=mt)
        snapshot(f"sync: {summary}")

    # org ごとに「一度でも存在した ID」を記録（削除検知用）。新しい org は空から始まる
    seen = load_seen(all_orgs, sessions)
    for org in all_orgs:
        now = {f.stem for f in org.glob("local_*.json")}
        seen[okey(org)] = sorted(set(seen.get(okey(org), [])) | now)
    STATE.write_text(json.dumps(seen, indent=0))

    if changed and notify:
        subprocess.run(["/usr/bin/osascript", "-e",
                        f'display notification "{summary}（org を切り替えるか再起動で反映）" '
                        f'with title "ccd-org-sync"'], capture_output=True)


def status():
    for org in orgs():
        fs = list(org.glob("local_*.json"))
        idx = load_idx(org)
        print(f"{label(org)}  一覧 {len(fs):>3} 件 / アーカイブ {len(idx['archived']) if idx else 0:>3} 件")
    if (GIT / ".git").exists():
        # 初回同期の途中は git init 済みでもコミットが無く git log が 128 で落ちる
        print(git("log", "-1", "--format=最終同期: %ci %s", check=False).stdout.strip())


def undo():
    git_init()
    out = git("log", "--format=%H %s").stdout.splitlines()
    syncs = [l.split(" ", 1)[0] for l in out if l.split(" ", 1)[1].startswith("sync:")]
    if not syncs:
        sys.exit("戻せる同期がありません")
    target = syncs[0]
    pre = git("rev-parse", f"{target}~1").stdout.strip()
    # pre 時点の内容を Desktop 側へ書き戻し、sync で増えたファイルは削除
    added = git("diff", "--name-only", "--diff-filter=A", pre, target, "--", "sessions").stdout.split()
    changed = git("diff", "--name-only", "--diff-filter=M", pre, target, "--", "sessions").stdout.split()
    for rel in changed:
        data = subprocess.run(["git", "-C", str(GIT), "show", f"{pre}:{rel}"],
                              capture_output=True, check=True).stdout
        atomic_write(CCS / Path(rel).relative_to("sessions"), data)
        log(f"RESTORE {rel}")
    for rel in added:
        p = CCS / Path(rel).relative_to("sessions")
        if p.exists():
            p.unlink()
            log(f"REMOVE  {rel}")
    snapshot(f"undo: revert {target[:8]}")
    log("完了。Claude Desktop を再起動してください")


# ---------- launchd エージェント ----------
LABEL = "com.ccd-org-sync"
PLIST = HOME / "Library/LaunchAgents" / f"{LABEL}.plist"
LOG_FILE = HOME / "Library/Logs/ccd-org-sync.log"
LEGACY_LABELS = ["com.hayasaka.ccd-org-sync"]


def _self_path():
    # Homebrew では Cellar のバージョン付きパスではなく、更新後も変わらない bin のリンクを使う
    found = shutil.which("ccd-org-sync")
    return found or str(Path(sys.argv[0]).absolute())


def _launchctl(*args):
    return subprocess.run(["/bin/launchctl", *args], capture_output=True, text=True)


def agent(sub):
    import plistlib
    domain = f"gui/{os.getuid()}"
    if sub == "install":
        if not CCS.is_dir():
            sys.exit(f"ERROR: {CCS} がありません（Claude Desktop を一度起動してください）")
        # 監視対象: claude-code-sessions 自体（新しいアカウント）・アカウント（新しい org）・各 org
        watch = [str(CCS)] + sorted(str(p) for p in CCS.glob("*") if p.is_dir()) \
                + sorted(str(p) for p in CCS.glob("*/*") if p.is_dir())
        for old in LEGACY_LABELS + [LABEL]:
            _launchctl("bootout", f"{domain}/{old}")
        for old in LEGACY_LABELS:
            (HOME / "Library/LaunchAgents" / f"{old}.plist").unlink(missing_ok=True)
        PLIST.parent.mkdir(parents=True, exist_ok=True)
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with open(PLIST, "wb") as fh:
            plistlib.dump({
                "Label": LABEL,
                "ProgramArguments": [_self_path(), "--notify"],
                "WatchPaths": watch,
                "StartInterval": 300,
                "ThrottleInterval": 20,
                "RunAtLoad": True,
                "StandardOutPath": str(LOG_FILE),
                "StandardErrorPath": str(LOG_FILE),
            }, fh)
        r = _launchctl("bootstrap", domain, str(PLIST))
        if r.returncode != 0:
            sys.exit(f"ERROR: launchctl bootstrap に失敗: {r.stderr.strip()}")
        print(f"自動実行を登録しました（{len(watch)} フォルダを監視）: {PLIST}")
        print("org やアカウントを追加したら、もう一度 `ccd-org-sync agent install` を実行してください")
    elif sub == "uninstall":
        _launchctl("bootout", f"{domain}/{LABEL}")
        PLIST.unlink(missing_ok=True)
        print("自動実行を解除しました")
    elif sub == "status":
        r = _launchctl("print", f"{domain}/{LABEL}")
        if r.returncode != 0:
            return print("自動実行: 未登録（`ccd-org-sync agent install` で登録）")
        state = re.search(r"^\s*state = (.+)$", r.stdout, re.M)
        runs = re.search(r"^\s*runs = (\d+)$", r.stdout, re.M)
        print(f"自動実行: 登録済み / state={state.group(1) if state else '?'} / "
              f"runs={runs.group(1) if runs else '?'} / log={LOG_FILE}")
    else:
        sys.exit("使い方: ccd-org-sync agent install|uninstall|status")


def main():
    args = sys.argv[1:]
    if "--version" in args:
        return print(f"ccd-org-sync {__version__}")
    if "-h" in args or "--help" in args:
        return print(__doc__)
    cmd = next((a for a in args if not a.startswith("-")), "sync")
    if cmd == "agent":
        rest = [a for a in args if not a.startswith("-")]
        return agent(rest[1] if len(rest) > 1 else "")
    if cmd == "status":
        return status()
    if cmd == "log":
        git_init()
        return print(git("log", "--format=%ci  %s", check=False).stdout)
    BASE.mkdir(parents=True, exist_ok=True)
    try:
        LOCK.mkdir()
    except FileExistsError:
        # 10分以上残っているロックは異常終了の残骸とみなす
        if time.time() - LOCK.stat().st_mtime > 600:
            LOCK.rmdir(); LOCK.mkdir()
        else:
            return log("別の ccd-org-sync が実行中のためスキップ")
    try:
        if cmd == "undo":
            undo()
        elif cmd == "sync":
            sync("--dry-run" in args, "--notify" in args)
        else:
            sys.exit(__doc__)
    finally:
        LOCK.rmdir()


if __name__ == "__main__":
    main()
